                        <Grid Width="40" Height="40">
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="0" /></Grid.RenderTransform><Ellipse x:Name="Ellipse1" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="30" /></Grid.RenderTransform><Ellipse x:Name="Ellipse2" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="60" /></Grid.RenderTransform><Ellipse x:Name="Ellipse3" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="90" /></Grid.RenderTransform><Ellipse x:Name="Ellipse4" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="120" /></Grid.RenderTransform><Ellipse x:Name="Ellipse5" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="150" /></Grid.RenderTransform><Ellipse x:Name="Ellipse6" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="180" /></Grid.RenderTransform><Ellipse x:Name="Ellipse7" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="210" /></Grid.RenderTransform><Ellipse x:Name="Ellipse8" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="240" /></Grid.RenderTransform><Ellipse x:Name="Ellipse9" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="270" /></Grid.RenderTransform><Ellipse x:Name="Ellipse10" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="300" /></Grid.RenderTransform><Ellipse x:Name="Ellipse11" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                            <Grid RenderTransformOrigin="50%,50%"><Grid.RenderTransform><RotateTransform Angle="330" /></Grid.RenderTransform><Ellipse x:Name="Ellipse12" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}" Width="{TemplateBinding Thickness}" Height="{TemplateBinding Thickness}" /></Grid>
                        </Grid>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
