<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:LoadingIndicators.Avalonia">

    <ControlTheme x:Key="Circle" TargetType="c:LoadingIndicator"
                  BasedOn="{StaticResource LoadingIndicatorBase}">
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="{TemplateBinding IsActive}"
                        IsHitTestVisible="{TemplateBinding IsHitTestVisible}"
                        ClipToBounds="{TemplateBinding ClipToBounds}">

                    <Border.Styles>
                        <Style Selector="Viewbox">
                            <Setter Property="Width" Value="{TemplateBinding Width}" />
                            <Setter Property="Height" Value="{TemplateBinding Height}" />
                            <Setter Property="StretchDirection" Value="Both" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style Selector="Ellipse">
                            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0" ScaleY="0" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Styles>

                    <Viewbox>
                        <Viewbox.Styles>
                            <Style Selector="c|LoadingIndicator:inactive /template/ Ellipse" />

                            <Style Selector="c|LoadingIndicator:active /template/ Ellipse#Ellipse1">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.200" IterationCount="Infinite" SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0" /><Setter Property="ScaleTransform.ScaleY" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="ScaleTransform.ScaleX" Value="0.129162" /><Setter Property="ScaleTransform.ScaleY" Value="0.129162" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="ScaleTransform.ScaleX" Value="0.5" /><Setter Property="ScaleTransform.ScaleY" Value="0.5" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="ScaleTransform.ScaleX" Value="0.870838" /><Setter Property="ScaleTransform.ScaleY" Value="0.870838" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="0.870838" /><Setter Property="ScaleTransform.ScaleY" Value="0.870838" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="ScaleTransform.ScaleX" Value="0.5" /><Setter Property="ScaleTransform.ScaleY" Value="0.5" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="ScaleTransform.ScaleX" Value="0.129162" /><Setter Property="ScaleTransform.ScaleY" Value="0.129162" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="ScaleTransform.ScaleX" Value="0" /><Setter Property="ScaleTransform.ScaleY" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="0" /><Setter Property="ScaleTransform.ScaleY" Value="0" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Ellipse#Ellipse2">
