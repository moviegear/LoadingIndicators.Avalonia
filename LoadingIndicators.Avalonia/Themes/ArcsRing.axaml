<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:LoadingIndicators.Avalonia">

    <ControlTheme x:Key="ArcsRing" TargetType="c:LoadingIndicator"
                  BasedOn="{StaticResource LoadingIndicatorBase}">
        <Setter Property="Thickness" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="{TemplateBinding IsActive}"
                        IsHitTestVisible="{TemplateBinding IsHitTestVisible}"
                        ClipToBounds="{TemplateBinding ClipToBounds}">

                    <Border.Styles>
                        <Style Selector="Viewbox">
                            <Setter Property="Width" Value="{TemplateBinding Width}" />
                            <Setter Property="Height" Value="{TemplateBinding Height}" />
                            <Setter Property="StretchDirection" Value="Both" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style Selector="Arc">
                            <Setter Property="Margin" Value="5" />
                            <Setter Property="MinWidth" Value="64" />
                            <Setter Property="MinHeight" Value="64" />
                            <Setter Property="StrokeLineCap" Value="Square" />
                            <Setter Property="SweepAngle" Value="20" />
                        </Style>
                    </Border.Styles>

                    <Viewbox>
                        <Viewbox.Styles>
                            <Style Selector="c|LoadingIndicator:inactive /template/ Arc" />

                            <Style Selector="c|LoadingIndicator:active /template/ Arc#Arc1">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.000"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">

                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Arc#Arc2">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.000"
                                               Delay="0:0:0.125"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">

                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Arc#Arc3">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.000"
                                               Delay="0:0:0.250"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">

                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Arc#Arc4">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.000"
                                               Delay="0:0:0.375"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">

                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Arc#Arc5">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.000"
                                               Delay="0:0:0.500"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">

                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Arc#Arc6">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.000"
                                               Delay="0:0:0.625"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">

                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Arc#Arc7">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.000"
                                               Delay="0:0:0.750"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">

                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Arc#Arc8">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.000"
                                               Delay="0:0:0.875"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">

                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="Opacity" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Viewbox.Styles>

                        <Grid>
                            <!-- Base layer: dim foreground, always visible -->
                            <Arc Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0.5"
                                 StartAngle="-100" />
                            <Arc Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0.5"
                                 StartAngle="-55" />
                            <Arc Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0.5"
                                 StartAngle="-10" />
                            <Arc Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0.5"
                                 StartAngle="35" />
                            <Arc Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0.5"
                                 StartAngle="80" />
                            <Arc Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0.5"
                                 StartAngle="125" />
                            <Arc Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0.5"
                                 StartAngle="170" />
                            <Arc Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0.5"
                                 StartAngle="215" />

                            <!-- Overlay layer: Foreground, opacity animated 0→1 when lit -->
                            <Arc x:Name="Arc1"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0"
                                 StartAngle="-100" />
                            <Arc x:Name="Arc2"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0"
                                 StartAngle="-55" />
                            <Arc x:Name="Arc3"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0"
                                 StartAngle="-10" />
                            <Arc x:Name="Arc4"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0"
                                 StartAngle="35" />
                            <Arc x:Name="Arc5"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0"
                                 StartAngle="80" />
                            <Arc x:Name="Arc6"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0"
                                 StartAngle="125" />
                            <Arc x:Name="Arc7"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0"
                                 StartAngle="170" />
                            <Arc x:Name="Arc8"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding Thickness}"
                                 Opacity="0"
                                 StartAngle="215" />
                        </Grid>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
