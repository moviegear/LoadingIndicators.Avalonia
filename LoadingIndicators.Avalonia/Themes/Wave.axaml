<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:LoadingIndicators.Avalonia">

    <ControlTheme x:Key="Wave" TargetType="c:LoadingIndicator"
                  BasedOn="{StaticResource LoadingIndicatorBase}">
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="{TemplateBinding IsActive}"
                        IsHitTestVisible="{TemplateBinding IsHitTestVisible}"
                        ClipToBounds="{TemplateBinding ClipToBounds}">

                    <Border.Styles>
                        <Style Selector="Viewbox">
                            <Setter Property="Width" Value="{TemplateBinding Width}" />
                            <Setter Property="Height" Value="{TemplateBinding Height}" />
                            <Setter Property="StretchDirection" Value="Both" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style Selector="Rectangle">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="0.4" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Styles>

                    <Viewbox>
                        <Viewbox.Styles>
                            <Style Selector="c|LoadingIndicator:inactive /template/ Rectangle" />

                            <Style Selector="c|LoadingIndicator:active /template/ Rectangle#Rectangle1">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.200"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="5%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="10%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="15%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="25%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="35%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="40%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Rectangle#Rectangle2">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.200"
                                               Delay="0:0:0.100"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="5%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="10%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="15%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="25%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="35%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="40%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Rectangle#Rectangle3">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.200"
                                               Delay="0:0:0.200"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="5%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="10%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="15%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="25%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="35%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="40%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Rectangle#Rectangle4">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.200"
                                               Delay="0:0:0.300"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="5%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="10%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="15%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="25%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="35%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="40%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Rectangle#Rectangle5">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.200"
                                               Delay="0:0:0.400"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="5%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="10%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="15%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="20%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="1" />
                                        </KeyFrame>

                                        <KeyFrame Cue="25%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.922503" />
                                        </KeyFrame>

                                        <KeyFrame Cue="30%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
                                        </KeyFrame>

                                        <KeyFrame Cue="35%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.477497" />
                                        </KeyFrame>

                                        <KeyFrame Cue="40%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Viewbox.Styles>

                        <Grid Width="50"
                              Height="40"
                              ColumnDefinitions="Auto,5,Auto,5,Auto,5,Auto,5,Auto">
                            <Rectangle x:Name="Rectangle1"
                                       Grid.Column="0"
                                       Fill="{TemplateBinding Foreground}"
                                       Width="{TemplateBinding Thickness}" />

                            <Rectangle x:Name="Rectangle2"
                                       Grid.Column="2"
                                       Fill="{TemplateBinding Foreground}"
                                       Width="{TemplateBinding Thickness}" />

                            <Rectangle x:Name="Rectangle3"
                                       Grid.Column="4"
                                       Fill="{TemplateBinding Foreground}"
                                       Width="{TemplateBinding Thickness}" />

                            <Rectangle x:Name="Rectangle4"
                                       Grid.Column="6"
                                       Fill="{TemplateBinding Foreground}"
                                       Width="{TemplateBinding Thickness}" />

                            <Rectangle x:Name="Rectangle5"
                                       Grid.Column="8"
                                       Fill="{TemplateBinding Foreground}"
                                       Width="{TemplateBinding Thickness}" />
                        </Grid>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
