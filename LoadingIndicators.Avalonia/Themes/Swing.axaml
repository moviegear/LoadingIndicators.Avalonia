<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:LoadingIndicators.Avalonia">

    <ControlTheme x:Key="Swing" TargetType="c:LoadingIndicator"
                  BasedOn="{StaticResource LoadingIndicatorBase}">
        <Setter Property="Thickness" Value="28.8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="{TemplateBinding IsActive}"
                        IsHitTestVisible="{TemplateBinding IsHitTestVisible}"
                        ClipToBounds="{TemplateBinding ClipToBounds}">

                    <Border.Styles>
                        <Style Selector="Viewbox">
                            <Setter Property="Width" Value="{TemplateBinding Width}" />
                            <Setter Property="Height" Value="{TemplateBinding Height}" />
                            <Setter Property="StretchDirection" Value="Both" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style Selector="Ellipse">
                            <Setter Property="Width" Value="{Binding $parent[c:LoadingIndicator].Thickness}" />
                            <Setter Property="Height" Value="{Binding $parent[c:LoadingIndicator].Thickness}" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.2" ScaleY="0.2" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Styles>

                    <Viewbox>
                        <Viewbox.Styles>
                            <Style Selector="c|LoadingIndicator:inactive /template/ Grid#SwingRoot" />

                            <Style Selector="c|LoadingIndicator:active /template/ Grid#SwingRoot">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.000"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                        </KeyFrame>

                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Ellipse#Ellipse1">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.000"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.2" /><Setter Property="ScaleTransform.ScaleY" Value="0.2" /></KeyFrame>
                                        <KeyFrame Cue="5%"><Setter Property="ScaleTransform.ScaleX" Value="0.215778" /><Setter Property="ScaleTransform.ScaleY" Value="0.215778" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="ScaleTransform.ScaleX" Value="0.265328" /><Setter Property="ScaleTransform.ScaleY" Value="0.265328" /></KeyFrame>
                                        <KeyFrame Cue="15%"><Setter Property="ScaleTransform.ScaleX" Value="0.349917" /><Setter Property="ScaleTransform.ScaleY" Value="0.349917" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="ScaleTransform.ScaleX" Value="0.465507" /><Setter Property="ScaleTransform.ScaleY" Value="0.465507" /></KeyFrame>
                                        <KeyFrame Cue="25%"><Setter Property="ScaleTransform.ScaleX" Value="0.6" /><Setter Property="ScaleTransform.ScaleY" Value="0.6" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="ScaleTransform.ScaleX" Value="0.734493" /><Setter Property="ScaleTransform.ScaleY" Value="0.734493" /></KeyFrame>
                                        <KeyFrame Cue="35%"><Setter Property="ScaleTransform.ScaleX" Value="0.850083" /><Setter Property="ScaleTransform.ScaleY" Value="0.850083" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="ScaleTransform.ScaleX" Value="0.934672" /><Setter Property="ScaleTransform.ScaleY" Value="0.934672" /></KeyFrame>
                                        <KeyFrame Cue="45%"><Setter Property="ScaleTransform.ScaleX" Value="0.984222" /><Setter Property="ScaleTransform.ScaleY" Value="0.984222" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                        <KeyFrame Cue="55%"><Setter Property="ScaleTransform.ScaleX" Value="0.984222" /><Setter Property="ScaleTransform.ScaleY" Value="0.984222" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="ScaleTransform.ScaleX" Value="0.934672" /><Setter Property="ScaleTransform.ScaleY" Value="0.934672" /></KeyFrame>
                                        <KeyFrame Cue="65%"><Setter Property="ScaleTransform.ScaleX" Value="0.850083" /><Setter Property="ScaleTransform.ScaleY" Value="0.850083" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="ScaleTransform.ScaleX" Value="0.734493" /><Setter Property="ScaleTransform.ScaleY" Value="0.734493" /></KeyFrame>
                                        <KeyFrame Cue="75%"><Setter Property="ScaleTransform.ScaleX" Value="0.6" /><Setter Property="ScaleTransform.ScaleY" Value="0.6" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="ScaleTransform.ScaleX" Value="0.465507" /><Setter Property="ScaleTransform.ScaleY" Value="0.465507" /></KeyFrame>
                                        <KeyFrame Cue="85%"><Setter Property="ScaleTransform.ScaleX" Value="0.349917" /><Setter Property="ScaleTransform.ScaleY" Value="0.349917" /></KeyFrame>
                                        <KeyFrame Cue="90%"><Setter Property="ScaleTransform.ScaleX" Value="0.265328" /><Setter Property="ScaleTransform.ScaleY" Value="0.265328" /></KeyFrame>
                                        <KeyFrame Cue="95%"><Setter Property="ScaleTransform.ScaleX" Value="0.215778" /><Setter Property="ScaleTransform.ScaleY" Value="0.215778" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="0.2" /><Setter Property="ScaleTransform.ScaleY" Value="0.2" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Ellipse#Ellipse2">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.000"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                        <KeyFrame Cue="5%"><Setter Property="ScaleTransform.ScaleX" Value="0.984222" /><Setter Property="ScaleTransform.ScaleY" Value="0.984222" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="ScaleTransform.ScaleX" Value="0.934672" /><Setter Property="ScaleTransform.ScaleY" Value="0.934672" /></KeyFrame>
                                        <KeyFrame Cue="15%"><Setter Property="ScaleTransform.ScaleX" Value="0.850083" /><Setter Property="ScaleTransform.ScaleY" Value="0.850083" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="ScaleTransform.ScaleX" Value="0.734493" /><Setter Property="ScaleTransform.ScaleY" Value="0.734493" /></KeyFrame>
                                        <KeyFrame Cue="25%"><Setter Property="ScaleTransform.ScaleX" Value="0.6" /><Setter Property="ScaleTransform.ScaleY" Value="0.6" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="ScaleTransform.ScaleX" Value="0.465507" /><Setter Property="ScaleTransform.ScaleY" Value="0.465507" /></KeyFrame>
                                        <KeyFrame Cue="35%"><Setter Property="ScaleTransform.ScaleX" Value="0.349917" /><Setter Property="ScaleTransform.ScaleY" Value="0.349917" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="ScaleTransform.ScaleX" Value="0.265328" /><Setter Property="ScaleTransform.ScaleY" Value="0.265328" /></KeyFrame>
                                        <KeyFrame Cue="45%"><Setter Property="ScaleTransform.ScaleX" Value="0.215778" /><Setter Property="ScaleTransform.ScaleY" Value="0.215778" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="0.2" /><Setter Property="ScaleTransform.ScaleY" Value="0.2" /></KeyFrame>
                                        <KeyFrame Cue="55%"><Setter Property="ScaleTransform.ScaleX" Value="0.215778" /><Setter Property="ScaleTransform.ScaleY" Value="0.215778" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="ScaleTransform.ScaleX" Value="0.265328" /><Setter Property="ScaleTransform.ScaleY" Value="0.265328" /></KeyFrame>
                                        <KeyFrame Cue="65%"><Setter Property="ScaleTransform.ScaleX" Value="0.349917" /><Setter Property="ScaleTransform.ScaleY" Value="0.349917" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="ScaleTransform.ScaleX" Value="0.465507" /><Setter Property="ScaleTransform.ScaleY" Value="0.465507" /></KeyFrame>
                                        <KeyFrame Cue="75%"><Setter Property="ScaleTransform.ScaleX" Value="0.6" /><Setter Property="ScaleTransform.ScaleY" Value="0.6" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="ScaleTransform.ScaleX" Value="0.734493" /><Setter Property="ScaleTransform.ScaleY" Value="0.734493" /></KeyFrame>
                                        <KeyFrame Cue="85%"><Setter Property="ScaleTransform.ScaleX" Value="0.850083" /><Setter Property="ScaleTransform.ScaleY" Value="0.850083" /></KeyFrame>
                                        <KeyFrame Cue="90%"><Setter Property="ScaleTransform.ScaleX" Value="0.934672" /><Setter Property="ScaleTransform.ScaleY" Value="0.934672" /></KeyFrame>
                                        <KeyFrame Cue="95%"><Setter Property="ScaleTransform.ScaleX" Value="0.984222" /><Setter Property="ScaleTransform.ScaleY" Value="0.984222" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Viewbox.Styles>

                        <Grid x:Name="SwingRoot"
                              Width="64"
                              Height="64"
                              RenderTransformOrigin="50%,50%">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Grid.RenderTransform>

                            <Ellipse x:Name="Ellipse1"
                                     VerticalAlignment="Top"
                                     Fill="{TemplateBinding Foreground}" />

                            <Ellipse x:Name="Ellipse2"
                                     VerticalAlignment="Bottom"
                                     Fill="{TemplateBinding Foreground}" />
                        </Grid>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
