<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:LoadingIndicators.Avalonia">

    <ControlTheme x:Key="Wander" TargetType="c:LoadingIndicator"
                  BasedOn="{StaticResource LoadingIndicatorBase}">
        <Setter Property="Thickness" Value="15" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="{TemplateBinding IsActive}"
                        IsHitTestVisible="{TemplateBinding IsHitTestVisible}"
                        ClipToBounds="{TemplateBinding ClipToBounds}">

                    <Border.Styles>
                        <Style Selector="Viewbox">
                            <Setter Property="Width" Value="{TemplateBinding Width}" />
                            <Setter Property="Height" Value="{TemplateBinding Height}" />
                            <Setter Property="StretchDirection" Value="Both" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Styles>

                    <Viewbox>
                        <Viewbox.Styles>
                            <Style Selector="c|LoadingIndicator:active /template/ Border#Cube1Translate">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.400"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="5%"><Setter Property="TranslateTransform.X" Value="3.266394" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="TranslateTransform.X" Value="13.275355" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="15%"><Setter Property="TranslateTransform.X" Value="26.724645" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="TranslateTransform.X" Value="36.733606" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="25%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="3.266394" /></KeyFrame>
                                        <KeyFrame Cue="35%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="13.275355" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="26.724645" /></KeyFrame>
                                        <KeyFrame Cue="45%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="36.733606" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="55%"><Setter Property="TranslateTransform.X" Value="36.733606" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="TranslateTransform.X" Value="26.724645" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="65%"><Setter Property="TranslateTransform.X" Value="13.275355" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="TranslateTransform.X" Value="3.266394" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="75%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="36.733606" /></KeyFrame>
                                        <KeyFrame Cue="85%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="26.724645" /></KeyFrame>
                                        <KeyFrame Cue="90%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="13.275355" /></KeyFrame>
                                        <KeyFrame Cue="95%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="3.266394" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Border#Cube1Rotate">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.400"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="5%"><Setter Property="RotateTransform.Angle" Value="-7.349387" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="RotateTransform.Angle" Value="-29.869548" /></KeyFrame>
                                        <KeyFrame Cue="15%"><Setter Property="RotateTransform.Angle" Value="-60.130452" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="RotateTransform.Angle" Value="-82.650613" /></KeyFrame>
                                        <KeyFrame Cue="25%"><Setter Property="RotateTransform.Angle" Value="-90" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="RotateTransform.Angle" Value="-97.267727" /></KeyFrame>
                                        <KeyFrame Cue="35%"><Setter Property="RotateTransform.Angle" Value="-119.537664" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="RotateTransform.Angle" Value="-149.462336" /></KeyFrame>
                                        <KeyFrame Cue="45%"><Setter Property="RotateTransform.Angle" Value="-171.732273" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="RotateTransform.Angle" Value="-179" /></KeyFrame>
                                        <KeyFrame Cue="55%"><Setter Property="RotateTransform.Angle" Value="-187.349387" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="RotateTransform.Angle" Value="-209.869548" /></KeyFrame>
                                        <KeyFrame Cue="65%"><Setter Property="RotateTransform.Angle" Value="-240.130452" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="RotateTransform.Angle" Value="-262.650613" /></KeyFrame>
                                        <KeyFrame Cue="75%"><Setter Property="RotateTransform.Angle" Value="-270" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="RotateTransform.Angle" Value="-277.349387" /></KeyFrame>
                                        <KeyFrame Cue="85%"><Setter Property="RotateTransform.Angle" Value="-299.869548" /></KeyFrame>
                                        <KeyFrame Cue="90%"><Setter Property="RotateTransform.Angle" Value="-330.130452" /></KeyFrame>
                                        <KeyFrame Cue="95%"><Setter Property="RotateTransform.Angle" Value="-352.650613" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-360" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Rectangle#Cube1Face">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.400"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                        <KeyFrame Cue="5%"><Setter Property="ScaleTransform.ScaleX" Value="0.95917" /><Setter Property="ScaleTransform.ScaleY" Value="0.95917" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="ScaleTransform.ScaleX" Value="0.834058" /><Setter Property="ScaleTransform.ScaleY" Value="0.834058" /></KeyFrame>
                                        <KeyFrame Cue="15%"><Setter Property="ScaleTransform.ScaleX" Value="0.665942" /><Setter Property="ScaleTransform.ScaleY" Value="0.665942" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="ScaleTransform.ScaleX" Value="0.54083" /><Setter Property="ScaleTransform.ScaleY" Value="0.54083" /></KeyFrame>
                                        <KeyFrame Cue="25%"><Setter Property="ScaleTransform.ScaleX" Value="0.5" /><Setter Property="ScaleTransform.ScaleY" Value="0.5" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="ScaleTransform.ScaleX" Value="0.54083" /><Setter Property="ScaleTransform.ScaleY" Value="0.54083" /></KeyFrame>
                                        <KeyFrame Cue="35%"><Setter Property="ScaleTransform.ScaleX" Value="0.665942" /><Setter Property="ScaleTransform.ScaleY" Value="0.665942" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="ScaleTransform.ScaleX" Value="0.834058" /><Setter Property="ScaleTransform.ScaleY" Value="0.834058" /></KeyFrame>
                                        <KeyFrame Cue="45%"><Setter Property="ScaleTransform.ScaleX" Value="0.95917" /><Setter Property="ScaleTransform.ScaleY" Value="0.95917" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                        <KeyFrame Cue="55%"><Setter Property="ScaleTransform.ScaleX" Value="0.95917" /><Setter Property="ScaleTransform.ScaleY" Value="0.95917" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="ScaleTransform.ScaleX" Value="0.834058" /><Setter Property="ScaleTransform.ScaleY" Value="0.834058" /></KeyFrame>
                                        <KeyFrame Cue="65%"><Setter Property="ScaleTransform.ScaleX" Value="0.665942" /><Setter Property="ScaleTransform.ScaleY" Value="0.665942" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="ScaleTransform.ScaleX" Value="0.54083" /><Setter Property="ScaleTransform.ScaleY" Value="0.54083" /></KeyFrame>
                                        <KeyFrame Cue="75%"><Setter Property="ScaleTransform.ScaleX" Value="0.5" /><Setter Property="ScaleTransform.ScaleY" Value="0.5" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="ScaleTransform.ScaleX" Value="0.54083" /><Setter Property="ScaleTransform.ScaleY" Value="0.54083" /></KeyFrame>
                                        <KeyFrame Cue="85%"><Setter Property="ScaleTransform.ScaleX" Value="0.665942" /><Setter Property="ScaleTransform.ScaleY" Value="0.665942" /></KeyFrame>
                                        <KeyFrame Cue="90%"><Setter Property="ScaleTransform.ScaleX" Value="0.834058" /><Setter Property="ScaleTransform.ScaleY" Value="0.834058" /></KeyFrame>
                                        <KeyFrame Cue="95%"><Setter Property="ScaleTransform.ScaleX" Value="0.95917" /><Setter Property="ScaleTransform.ScaleY" Value="0.95917" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Border#Cube2Translate">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.400"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="5%"><Setter Property="TranslateTransform.X" Value="36.733606" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="TranslateTransform.X" Value="26.724645" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="15%"><Setter Property="TranslateTransform.X" Value="13.275355" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="TranslateTransform.X" Value="3.266394" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="25%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="36.733606" /></KeyFrame>
                                        <KeyFrame Cue="35%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="26.724645" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="13.275355" /></KeyFrame>
                                        <KeyFrame Cue="45%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="3.266394" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="55%"><Setter Property="TranslateTransform.X" Value="3.266394" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="TranslateTransform.X" Value="13.275355" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="65%"><Setter Property="TranslateTransform.X" Value="26.724645" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="TranslateTransform.X" Value="36.733606" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="75%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="3.266394" /></KeyFrame>
                                        <KeyFrame Cue="85%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="13.275355" /></KeyFrame>
                                        <KeyFrame Cue="90%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="26.724645" /></KeyFrame>
                                        <KeyFrame Cue="95%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="36.733606" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="40" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Border#Cube2Rotate">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.400"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-179" /></KeyFrame>
                                        <KeyFrame Cue="5%"><Setter Property="RotateTransform.Angle" Value="-187.349387" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="RotateTransform.Angle" Value="-209.869548" /></KeyFrame>
                                        <KeyFrame Cue="15%"><Setter Property="RotateTransform.Angle" Value="-240.130452" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="RotateTransform.Angle" Value="-262.650613" /></KeyFrame>
                                        <KeyFrame Cue="25%"><Setter Property="RotateTransform.Angle" Value="-270" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="RotateTransform.Angle" Value="-277.349387" /></KeyFrame>
                                        <KeyFrame Cue="35%"><Setter Property="RotateTransform.Angle" Value="-299.869548" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="RotateTransform.Angle" Value="-330.130452" /></KeyFrame>
                                        <KeyFrame Cue="45%"><Setter Property="RotateTransform.Angle" Value="-352.650613" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="RotateTransform.Angle" Value="-360" /></KeyFrame>
                                        <KeyFrame Cue="55%"><Setter Property="RotateTransform.Angle" Value="-367.349387" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="RotateTransform.Angle" Value="-389.869548" /></KeyFrame>
                                        <KeyFrame Cue="65%"><Setter Property="RotateTransform.Angle" Value="-420.130452" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="RotateTransform.Angle" Value="-442.650613" /></KeyFrame>
                                        <KeyFrame Cue="75%"><Setter Property="RotateTransform.Angle" Value="-450" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="RotateTransform.Angle" Value="-457.267727" /></KeyFrame>
                                        <KeyFrame Cue="85%"><Setter Property="RotateTransform.Angle" Value="-479.537664" /></KeyFrame>
                                        <KeyFrame Cue="90%"><Setter Property="RotateTransform.Angle" Value="-509.462336" /></KeyFrame>
                                        <KeyFrame Cue="95%"><Setter Property="RotateTransform.Angle" Value="-531.732273" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-539" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <Style Selector="c|LoadingIndicator:active /template/ Rectangle#Cube2Face">
                                <Style.Animations>
                                    <Animation Duration="0:0:2.400"
                                               IterationCount="Infinite"
                                               SpeedRatio="{Binding $parent[c:LoadingIndicator].SpeedRatio}">
                                        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                        <KeyFrame Cue="5%"><Setter Property="ScaleTransform.ScaleX" Value="0.95917" /><Setter Property="ScaleTransform.ScaleY" Value="0.95917" /></KeyFrame>
                                        <KeyFrame Cue="10%"><Setter Property="ScaleTransform.ScaleX" Value="0.834058" /><Setter Property="ScaleTransform.ScaleY" Value="0.834058" /></KeyFrame>
                                        <KeyFrame Cue="15%"><Setter Property="ScaleTransform.ScaleX" Value="0.665942" /><Setter Property="ScaleTransform.ScaleY" Value="0.665942" /></KeyFrame>
                                        <KeyFrame Cue="20%"><Setter Property="ScaleTransform.ScaleX" Value="0.54083" /><Setter Property="ScaleTransform.ScaleY" Value="0.54083" /></KeyFrame>
                                        <KeyFrame Cue="25%"><Setter Property="ScaleTransform.ScaleX" Value="0.5" /><Setter Property="ScaleTransform.ScaleY" Value="0.5" /></KeyFrame>
                                        <KeyFrame Cue="30%"><Setter Property="ScaleTransform.ScaleX" Value="0.54083" /><Setter Property="ScaleTransform.ScaleY" Value="0.54083" /></KeyFrame>
                                        <KeyFrame Cue="35%"><Setter Property="ScaleTransform.ScaleX" Value="0.665942" /><Setter Property="ScaleTransform.ScaleY" Value="0.665942" /></KeyFrame>
                                        <KeyFrame Cue="40%"><Setter Property="ScaleTransform.ScaleX" Value="0.834058" /><Setter Property="ScaleTransform.ScaleY" Value="0.834058" /></KeyFrame>
                                        <KeyFrame Cue="45%"><Setter Property="ScaleTransform.ScaleX" Value="0.95917" /><Setter Property="ScaleTransform.ScaleY" Value="0.95917" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                        <KeyFrame Cue="55%"><Setter Property="ScaleTransform.ScaleX" Value="0.95917" /><Setter Property="ScaleTransform.ScaleY" Value="0.95917" /></KeyFrame>
                                        <KeyFrame Cue="60%"><Setter Property="ScaleTransform.ScaleX" Value="0.834058" /><Setter Property="ScaleTransform.ScaleY" Value="0.834058" /></KeyFrame>
                                        <KeyFrame Cue="65%"><Setter Property="ScaleTransform.ScaleX" Value="0.665942" /><Setter Property="ScaleTransform.ScaleY" Value="0.665942" /></KeyFrame>
                                        <KeyFrame Cue="70%"><Setter Property="ScaleTransform.ScaleX" Value="0.54083" /><Setter Property="ScaleTransform.ScaleY" Value="0.54083" /></KeyFrame>
                                        <KeyFrame Cue="75%"><Setter Property="ScaleTransform.ScaleX" Value="0.5" /><Setter Property="ScaleTransform.ScaleY" Value="0.5" /></KeyFrame>
                                        <KeyFrame Cue="80%"><Setter Property="ScaleTransform.ScaleX" Value="0.54083" /><Setter Property="ScaleTransform.ScaleY" Value="0.54083" /></KeyFrame>
                                        <KeyFrame Cue="85%"><Setter Property="ScaleTransform.ScaleX" Value="0.665942" /><Setter Property="ScaleTransform.ScaleY" Value="0.665942" /></KeyFrame>
                                        <KeyFrame Cue="90%"><Setter Property="ScaleTransform.ScaleX" Value="0.834058" /><Setter Property="ScaleTransform.ScaleY" Value="0.834058" /></KeyFrame>
                                        <KeyFrame Cue="95%"><Setter Property="ScaleTransform.ScaleX" Value="0.95917" /><Setter Property="ScaleTransform.ScaleY" Value="0.95917" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Viewbox.Styles>

                        <Grid>
                            <!-- Transparent spacer: forces Grid (and Canvas) to Thickness + 40,
                            where 40 is the fixed travel distance matching the animation keyframes. -->
                            <Border Width="{TemplateBinding Thickness}"
                                    Height="{TemplateBinding Thickness}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,0,40,40" />
                            <Canvas>
                                <Border x:Name="Cube1Translate"
                                        Width="{TemplateBinding Thickness}"
                                        Height="{TemplateBinding Thickness}"
                                        Canvas.Left="0"
                                        Canvas.Top="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="0" />
                                    </Border.RenderTransform>

                                    <Border x:Name="Cube1Rotate"
                                            Width="{TemplateBinding Thickness}"
                                            Height="{TemplateBinding Thickness}"
                                            RenderTransformOrigin="50%,50%">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Border.RenderTransform>

                                        <Rectangle x:Name="Cube1Face"
                                                   Width="{TemplateBinding Thickness}"
                                                   Height="{TemplateBinding Thickness}"
                                                   Fill="{TemplateBinding Foreground}"
                                                   RenderTransformOrigin="50%,50%">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Border>
                                </Border>

                                <Border x:Name="Cube2Translate"
                                        Width="{TemplateBinding Thickness}"
                                        Height="{TemplateBinding Thickness}"
                                        Canvas.Left="0"
                                        Canvas.Top="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="40" Y="40" />
                                    </Border.RenderTransform>

                                    <Border x:Name="Cube2Rotate"
                                            Width="{TemplateBinding Thickness}"
                                            Height="{TemplateBinding Thickness}"
                                            RenderTransformOrigin="50%,50%">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-179" />
                                        </Border.RenderTransform>

                                        <Rectangle x:Name="Cube2Face"
                                                   Width="{TemplateBinding Thickness}"
                                                   Height="{TemplateBinding Thickness}"
                                                   Fill="{TemplateBinding Foreground}"
                                                   RenderTransformOrigin="50%,50%">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Border>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
